# --- app ---------------------------------------------------------------
APP_NAME=Mechanic AI v2
APP_PORT=8000
LOG_LEVEL=INFO

# --- database ----------------------------------------------------------
# Host port is 5433 because a native Postgres already owns 5432 on dev machines.
DATABASE_URL=postgresql://mechanic:mechanic@localhost:5433/mechanic

# --- language model (any OpenAI-compatible provider) --------------------
# Mistral free tier: https://console.mistral.ai
# Groq alternative:  LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-small-latest
LLM_MAX_TOKENS=600
LLM_TIMEOUT_S=60

# --- retrieval ---------------------------------------------------------
# dense = baseline | hybrid = dense+BM25 via RRF | reranked = hybrid+cross-encoder
RETRIEVAL_STRATEGY=reranked
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# candidates the cheap stage hands to the cross-encoder (swept: deeper was worse)
CANDIDATE_POOL=8
# how deep dense and BM25 each nominate before RRF fuses them
FUSION_DEPTH=10
RRF_K=60
